# Server-side env for docker compose (do not commit the real .env).
# Copy to .env on the VPS at APP_PATH (/var/www/noslop).

POSTGRES_USER=socratic
POSTGRES_PASSWORD=change-me-strong-db-password
POSTGRES_DB=socratic

# Used by the API container. Host `db` is the compose service name.
DATABASE_URL=postgresql+psycopg://socratic:change-me-strong-db-password@db:5432/socratic

SECRET_KEY=change-me-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=10080
API_BASE_URL=https://noslopapi.codemygig.com
CORS_ORIGINS=https://noslop.codemygig.com

# Coach LLM
LLM_MODEL=anthropic:claude-haiku-4-5
ANTHROPIC_API_KEY=

SANDBOX_ENABLED=true
SANDBOX_IMAGE=socratic-sandbox-node:latest
# Host path shared with sandbox containers (must exist on the VPS).
SANDBOX_WORKSPACES_ROOT=/var/www/noslop/data/workspaces
SANDBOX_MEMORY_MB=512
SANDBOX_CPUS=1.0
SANDBOX_TIMEOUT_SEC=30
SANDBOX_PIDS_LIMIT=64

# Host ports behind nginx (localhost only in compose)
API_PORT=8010
WEB_PORT=3010

# Override image tags if needed (workflow sets SHA tags on deploy)
# API_IMAGE=ghcr.io/haywhyoh/socratic-learner-api:latest
# WEB_IMAGE=ghcr.io/haywhyoh/socratic-learner-web:latest
