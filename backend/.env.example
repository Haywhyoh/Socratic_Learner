DATABASE_URL=postgresql+psycopg://macpro@localhost:5432/socratic
TEST_DATABASE_URL=postgresql+psycopg://macpro@localhost:5432/socratic_test
SECRET_KEY=change-me-in-production-use-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=10080
API_BASE_URL=http://localhost:8000
CORS_ORIGINS=http://localhost:3000

# Coach LLM — use stub (default) or Anthropic Haiku/Sonnet
LLM_MODEL=anthropic:claude-haiku-4-5
# LLM_MODEL=anthropic:claude-sonnet-4-6
ANTHROPIC_API_KEY=
# Optional alias; Anthropic prefers ANTHROPIC_API_KEY
LLM_API_KEY=

# Python sandbox (Docker). Requires a Docker daemon + built image.
# Lightweight option on macOS: brew install docker colima && colima start
SANDBOX_ENABLED=true
# SANDBOX_WORKSPACES_ROOT=./data/workspaces
SANDBOX_IMAGE=socratic-sandbox-python:latest
SANDBOX_MEMORY_MB=512
SANDBOX_CPUS=1.0
SANDBOX_TIMEOUT_SEC=30
SANDBOX_PIDS_LIMIT=64
# If docker.from_env() cannot find the daemon (Colima), set:
# DOCKER_HOST=unix:///Users/macpro/.colima/default/docker.sock
